# =============================================================================
# STAGING — modelo de variáveis
#
# NENHUM VALOR REAL AQUI. Este arquivo descreve QUAIS variáveis existem e onde
# cada uma é usada. Os valores vivem no painel do provedor (Render/Vercel),
# cifrados, e nunca neste repositório.
#
# Staging é ambiente descartável, exposto na internet, com TLS. Não é produção
# e não recebe dado real de pessoa nenhuma.
# =============================================================================

# -----------------------------------------------------------------------------
# ADMINISTRATIVO — usado APENAS por um operador, a partir da máquina dele.
#
# Nunca entra em serviço nenhum do Render. Um processo de execução contínua com
# credencial de dono do schema transforma qualquer falha sua em acesso total.
# -----------------------------------------------------------------------------
# Dono do banco no Neon. Roda bootstrap, migrations e queue:install.
DATABASE_ADMIN_URL=
# O migrador lê esta; aponte para o mesmo valor de DATABASE_ADMIN_URL.
MIGRATION_DATABASE_URL=
# Usada uma vez pelo bootstrap para criar os papéis restritos.
ADMIN_DATABASE_URL=
DATABASE_NAME=campaigns_staging
APP_DB_PASSWORD=
WORKER_DB_PASSWORD=
# Instalação do schema da fila (etapa administrativa).
QUEUE_ADMIN_DATABASE_URL=

# -----------------------------------------------------------------------------
# API — serviço web no Render (campaigns-api-staging)
# -----------------------------------------------------------------------------
NODE_ENV=staging
PORT=10000

# Papel RESTRITO app_user. Nunca o dono do schema.
DATABASE_URL=
DATABASE_SSL=true

# CA raiz do provedor, em PEM. NÃO É SEGREDO — é um certificado público.
#
# Provedores gerenciados assinam o certificado do banco com uma raiz própria,
# fora da lista de CAs públicas do Node (o Supabase usa a "Supabase Root 2021
# CA"). Sem informá-la, a conexão falha com `SELF_SIGNED_CERT_IN_CHAIN`. A saída
# tentadora seria desligar `rejectUnauthorized` — isso manteria a conexão
# cifrada e jogaria fora a única coisa que prova COM QUEM se está falando.
#
# Baixe do painel do provedor (Supabase → Settings → Database → SSL). Pode ser
# colado em uma única linha com `\n` escapado: o helper normaliza.
DATABASE_CA_CERT=

# 32 bytes em base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perder esta chave invalida todos os segundos fatores já cadastrados.
MFA_ENCRYPTION_KEY=

# Os quatro hosts de staging, separados por vírgula, SEM curinga.
# SAME-SITE NÃO É SAME-ORIGIN: os hosts compartilham o domínio registrável, mas
# cada um é uma origem distinta, e CORS continua obrigatório em toda chamada.
#   https://staging.<BASE_DOMAIN>
#   https://painel.staging.<BASE_DOMAIN>
#   https://admin.staging.<BASE_DOMAIN>
#   https://demo.staging.<BASE_DOMAIN>
CORS_ORIGINS=

# Sufixo dos subdomínios de comunidade: staging.<BASE_DOMAIN>
# Com isto, o originGuard aceita a origem de qualquer comunidade EXISTENTE em
# {slug}.staging.<BASE_DOMAIN>, sem listar cada tenant no CORS.
APP_BASE_DOMAIN=

# TOPOLOGIA SAME-SITE (domínio próprio de staging).
#
# api.staging.<BASE_DOMAIN> e painel.staging.<BASE_DOMAIN> têm o mesmo domínio
# registrável, logo são same-site — e um cookie `Lax` É enviado no `fetch`
# entre eles. `None` só seria necessário com domínios registráveis diferentes
# (`*.vercel.app` × `*.onrender.com`, porque `vercel.app` está na Public
# Suffix List). Com domínio próprio, `Lax` mantém a proteção contra POST vindo
# de um site externo.
#
# O cookie é HOST-ONLY: nenhum `Domain` é definido, então ele pertence só ao
# host da API. Um `Domain=.staging.<...>` o entregaria a todo subdomínio.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_NAME=campaigns_session
SESSION_TTL_HOURS=12

# LIMITAÇÃO CONHECIDA, não resolvida nesta rodada.
# Quando demo.staging.<BASE_DOMAIN> chama api.staging.<BASE_DOMAIN>, a API
# recebe a requisição no PRÓPRIO hostname — subdomínio de vitrine não faz o
# `Host` carregar a comunidade. Em staging o cabeçalho supre isso para
# comunidades descartáveis; ele escolhe QUAL comunidade e nunca concede
# privilégio (toda rota autenticada confere o vínculo no banco).
# A configuração RECUSA este valor em produção.
TENANT_HEADER_ENABLED=true

# Bloqueio por CONTA.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Limite por ORIGEM, anterior à autenticação. Impede que uma origem tranque
# muitas contas conhecidas. Ver apps/api/src/lib/loginThrottle.ts.
LOGIN_ORIGIN_WINDOW_MINUTES=15
LOGIN_ORIGIN_MAX_FAILURES=20
LOGIN_ORIGIN_MAX_ACCOUNTS=5

MFA_ISSUER=Campanhas e Comunidades (staging)

# -----------------------------------------------------------------------------
# WORKER — background worker no Render (campaigns-worker-staging)
# -----------------------------------------------------------------------------
# Papel app_worker. O nome é próprio para tornar impossível trocar pela
# conexão da API sem perceber.
WORKER_DATABASE_URL=
# Mesmo papel: o schema `pgboss` já pertence a ele (migration 0008).
QUEUE_DATABASE_URL=
QUEUE_SCHEMA=pgboss

OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_SECONDS=5

# -----------------------------------------------------------------------------
# As variaveis VITE_ sairam daqui.
#
# Elas sao embutidas no pacote entregue ao navegador — sao publicas por
# construcao — e agora vivem no repositorio tironirifa-frontend, junto das
# aplicacoes que as consomem. Nenhum segredo deste arquivo deve atravessar
# para la.
# -----------------------------------------------------------------------------
