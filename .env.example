# =============================================================================
# Clube da Rifa — variáveis de ambiente
#
# Copie para `.env` e preencha. NENHUM VALOR REAL DE SEGREDO ESTÁ AQUI.
# `.env` está no .gitignore e não deve ser versionado.
#
# Credenciais de PSP (Mercado Pago, Vindi) NÃO aparecem neste arquivo: os
# pagamentos pertencem às fases 2 e 8, e a especificação exige que essas
# credenciais fiquem em cofre de segredos, nunca no banco em texto.
# =============================================================================

# -----------------------------------------------------------------------------
# Banco — três papéis distintos, de propósito
#
#  ADMIN_*      superusuário. Usado UMA vez, pelo bootstrap, para criar o banco
#               e os papéis restritos.
#  MIGRATION_*  dono do schema. Roda as migrations. NÃO é usado pela aplicação.
#  DATABASE_URL papel `app_user`, restrito. É com ele que a API roda, e é por
#               isso que a RLS vale de verdade: app_user não é dono das tabelas
#               e não tem BYPASSRLS.
# -----------------------------------------------------------------------------
ADMIN_DATABASE_URL=postgres://postgres:TROQUE_ESTA_SENHA@localhost:5432/postgres
DATABASE_NAME=clubedarifa

MIGRATION_DATABASE_URL=postgres://postgres:TROQUE_ESTA_SENHA@localhost:5432/clubedarifa

# Senhas dos papéis restritos, definidas pelo bootstrap.
APP_DB_PASSWORD=TROQUE_ESTA_SENHA
WORKER_DB_PASSWORD=TROQUE_ESTA_SENHA

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://app_user:TROQUE_ESTA_SENHA@localhost:5432/clubedarifa
# `true` em provedor gerenciado (Supabase exige TLS); `false` em Postgres local.
DATABASE_SSL=false

# Chave AES-256 dos segredos TOTP, 32 bytes em base64. GERE A SUA:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perder esta chave invalida todos os segundos fatores cadastrados.
MFA_ENCRYPTION_KEY=

# Domínio base das vitrines: {slug}.{APP_BASE_DOMAIN}
APP_BASE_DOMAIN=clubedarifa.local

# Aceitar o cabeçalho `x-tenant-slug` para escolher a comunidade.
#
# `true` SOMENTE em desenvolvimento, onde os três frontends rodam em localhost
# sem subdomínio por comunidade. O cabeçalho é um seletor controlado pelo
# cliente: ligado, qualquer requisição — de qualquer host — escolhe a
# comunidade que quiser, e a regra "domínio desconhecido devolve 404" deixa de
# valer. A API RECUSA subir com isto em `true` e NODE_ENV=production.
TENANT_HEADER_ENABLED=true

# Origens dos três frontends, separadas por vírgula. O cookie de sessão só
# viaja para as origens declaradas aqui.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

SESSION_COOKIE_NAME=clubedarifa_session
SESSION_TTL_HOURS=12
# `true` em produção (HTTPS). `false` em localhost, senão o cookie não é salvo.
SESSION_COOKIE_SECURE=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Nome exibido no aplicativo autenticador.
MFA_ISSUER=Clube da Rifa

# -----------------------------------------------------------------------------
# Pagamento PIX (Mercado Pago). Desligado por padrao.
#
# Cada comunidade conecta a SUA conta do Mercado Pago por OAuth (authorization_code +
# PKCE): NAO existe access token global e nenhum token e digitado a mao. O que mora
# aqui e so do APLICATIVO da plataforma. Tokens dos vendedores ficam cifrados no banco
# com PAYMENT_CREDENTIALS_KEY (chave propria, diferente da do MFA).
#
# PSP_PROVIDER=mercadopago exige TODAS as variaveis abaixo (API e worker); o processo
# recusa subir com o provedor "pela metade". Segredos moram AQUI (ambiente) ou no cofre
# do Render — nunca no codigo nem no banco.
#
# Cadastrar no painel do aplicativo no Mercado Pago:
#   Redirect URI : {PUBLIC_API_BASE_URL}/api/payment-accounts/oauth/callback
#   Webhook      : {PUBLIC_API_BASE_URL}/api/webhooks/mercadopago/{slug-da-comunidade}
#                  (assinado com MERCADOPAGO_WEBHOOK_SECRET, o segredo do aplicativo)
# -----------------------------------------------------------------------------
PSP_PROVIDER=none
MERCADOPAGO_OAUTH_CLIENT_ID=
MERCADOPAGO_OAUTH_CLIENT_SECRET=
MERCADOPAGO_WEBHOOK_SECRET=
# 32 bytes em base64 (openssl rand -base64 32). Diferente de MFA_ENCRYPTION_KEY.
PAYMENT_CREDENTIALS_KEY=
# Painel do organizador: para onde o retorno do OAuth redireciona (/recebimentos).
ORGANIZER_PANEL_URL=
# E-mail usado quando o comprador nao informa o dele (o Mercado Pago exige um).
MERCADOPAGO_FALLBACK_PAYER_EMAIL=
PUBLIC_API_BASE_URL=

# -----------------------------------------------------------------------------
# Assinaturas da PLATAFORMA (Stripe Billing) — FLUXO A. Desligado por padrao.
#
# Independente do PIX acima: sao contas, credenciais e webhooks diferentes, e o
# dinheiro da assinatura nunca passa pelo caminho do dinheiro do participante.
#
# BILLING_PROVIDER=stripe exige as tres variaveis abaixo (a API recusa subir com o
# provedor "pela metade"). A chave `sk_live_...` so e aceita com NODE_ENV=production;
# em desenvolvimento e staging use SEMPRE `sk_test_...` (modo de teste da Stripe).
# Credenciais moram AQUI (ambiente) ou no cofre do Render — nunca no codigo nem no banco.
#
# Webhook a cadastrar no painel da Stripe (modo teste), com os eventos:
#   checkout.session.completed, customer.subscription.created,
#   customer.subscription.updated, customer.subscription.deleted,
#   invoice.paid, invoice.payment_failed
#   URL: {PUBLIC_API_BASE_URL}/api/webhooks/stripe
# O segredo de assinatura (`whsec_...`) desse endpoint vai em STRIPE_WEBHOOK_SECRET.
# O worker le as MESMAS tres primeiras variaveis (processa e reprocessa os eventos).
# -----------------------------------------------------------------------------
BILLING_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# URL do painel do organizador, para onde a Stripe devolve a pessoa (sem barra final).
BILLING_RETURN_URL=

# -----------------------------------------------------------------------------
# Worker
#
# O worker roda com `app_worker` — restrito, sem BYPASSRLS e sem DDL no schema
# `public`, onde vivem os dados de negócio. Nenhuma conexão de superusuário
# aparece aqui: o worker é um processo de execução contínua, e um superusuário
# num processo desses transforma qualquer falha sua em acesso total ao banco.
#
# O SCHEMA DA FILA é a única exceção, e ela é resolvida na migration, não na
# credencial: a `0007`/`0008` criam `pgboss` com `app_worker` como DONO. O
# pg-boss cria e mantém suas tabelas DENTRO desse schema, exercendo posse — não
# privilégio administrativo. A separação fica onde deve estar:
#
#   bootstrap/migration  cria o schema e define o dono   (papel administrativo)
#   runtime do worker    cria as tabelas da fila no schema que já possui
#
# DATABASE_URL e QUEUE_DATABASE_URL usam o MESMO papel e continuam separadas
# porque são pools distintos com ciclos de vida distintos — e porque apontar a
# fila para outro banco, mais tarde, não deve exigir mexer no papel de negócio.
# -----------------------------------------------------------------------------
WORKER_DATABASE_URL=postgres://app_worker:TROQUE_ESTA_SENHA@localhost:5432/clubedarifa
QUEUE_DATABASE_URL=postgres://app_worker:TROQUE_ESTA_SENHA@localhost:5432/clubedarifa
QUEUE_SCHEMA=pgboss

OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_SECONDS=5

# -----------------------------------------------------------------------------
# Testes
#
# Os testes de isolamento rodam com o papel REAL da aplicação. Testar RLS como
# superusuário não prova nada: o dono das tabelas ignora as policies.
# Use um banco SEPARADO do de desenvolvimento — a suíte apaga dados.
# -----------------------------------------------------------------------------
TEST_MIGRATION_DATABASE_URL=postgres://postgres:TROQUE_ESTA_SENHA@localhost:5432/clubedarifa_test
TEST_APP_DATABASE_URL=postgres://app_user:TROQUE_ESTA_SENHA@localhost:5432/clubedarifa_test
TEST_WORKER_DATABASE_URL=postgres://app_worker:TROQUE_ESTA_SENHA@localhost:5432/clubedarifa_test
